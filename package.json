{
  "name": "react-phone-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A frontend demo of a responsive phone catalog",
  "author": "Mykhailo Loniak",
  "license": "GPL-3.0",
  "engines": {"node": ">=20.19 <25"},
  "dependencies": {
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "cypress": "^16.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "sass": "^1.92.1",
    "stylelint": "^16.23.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.4",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "cypress run",
    "lint-js": "eslint .",
    "lint-css": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\"",
    "lint": "npm run lint-js && npm run lint-css"
  }
}
