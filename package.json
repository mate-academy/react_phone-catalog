{
  "name": "group-project-2026",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "format": "prettier . --ignore-path .gitignore --write",
    "lint": "eslint . --fix",
    "fix-style": "npm run format && npm run lint",
    "preview": "vite preview",
    "prepare": "husky",
    "typecheck": "tsc -b",
